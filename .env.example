EXPO_PUBLIC_API_BASE_URL=https://further-cgi-webcast-accommodations.trycloudflare.com

# 소셜 로그인 키. 비워두면 로그인 버튼이 "키가 아직 없어요" 안내를 띄운다.
# 카카오: 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
#   - 카카오 로그인 활성화 + Redirect URI에 handdam://oauth 등록 필요
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# 구글: Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
#   - 플랫폼별로 클라이언트를 따로 발급해야 한다 (iOS / Android / 웹)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
